# GLM handles GraphRAG extraction, entity alignment, reports, and queries.
ZAI_API_KEY=your_zai_api_key
ZAI_CHAT_MODEL=glm-4.5-air

# Z.AI's OpenAI-compatible endpoint also serves Zhipu embedding-3.
ZHIPU_API_KEY=your_zhipu_api_key
ZHIPU_API_BASE=https://open.bigmodel.cn/api/paas/v4
ZHIPU_EMBEDDING_MODEL=embedding-3
ZHIPU_EMBEDDING_DIMENSIONS=2048

# Claude Agent SDK maps these DeepSeek values to Anthropic-compatible names.
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_CHAT_MODEL=deepseek-v4-flash
DEEPSEEK_ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
