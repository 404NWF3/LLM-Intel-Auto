# 无需 API 密钥即可运行规则采集；复制为 .env 后按需启用以下配置。
# SDK 智能采集：选择 deepseek 或 glm，只需填写对应供应商的密钥。
INTEL_SDK_PROVIDER=
DEEPSEEK_API_KEY=
GLM_API_KEY=

# DeepSeek 主模型和快速模型默认均为 deepseek-flash（当前对应 V4.1 Flash）。
# 可选：覆盖供应商默认模型（模型名称须与所用端点匹配）。
# INTEL_SDK_MODEL=
# INTEL_SDK_FAST_MODEL=
# 自定义 Anthropic 兼容端点时，同时设置下面两项：
# ANTHROPIC_BASE_URL=
# ANTHROPIC_AUTH_TOKEN=

# 可选：GLM 语义过滤与技巧库 embedding；未填 GLM_API_KEY 时使用规则过滤。
# GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# INTEL_EMBEDDING_MODEL=embedding-3
# INTEL_RELEVANCE_JUDGE_MODEL=glm-4.7-flash
# INTEL_RELEVANCE_ENABLED=1
# INTEL_PLAYBOOK_ENABLED=1
# INTEL_PLAYBOOK_EMBED=1

# 可选：NVD API 密钥（无密钥也能访问，限流更严格）。
# NVD_API_KEY=

# 采集调参；通常直接使用代码默认值即可。
# INTEL_COVERAGE_QUOTA=3
# INTEL_INCREMENTAL_STRATEGY=adaptive
# INTEL_INCREMENTAL_OVERLAP_HOURS=72
# INTEL_STALL_PATIENCE=2
# INTEL_MIN_NEW_RELEVANT_PER_CALL=0.5
# INTEL_AGENT_MAX_TURNS=24
# INTEL_AGENT_HOOKS=1
# INTEL_AGENT_PLAYBOOK_PATH=data/intel_agent/playbook.jsonl

# 存储默认使用本地 JSON，不需要 MongoDB。
# 使用 docker compose 的 MongoDB 时，宿主机配置：
# INTEL_MONGO_URI=mongodb://localhost:27018
# INTEL_MONGO_DB=intel_agent
# INTEL_MONGO_HOST_PORT=27018

# 本地控制台（容器监听地址由 compose 设置）。
GRADIO_SERVER_NAME=127.0.0.1
GRADIO_SERVER_PORT=8000
